          "ziel_einspeise_leistung": "Check: export power (helper)"
        }
      }
    },
    "error": { "gleiche_entitaet": "Import and export must be different entities." },
    "abort": { "single_instance_allowed": "Only a single instance is allowed." }
  },
  "options": {
    "step": {
      "init": {
        "title": "Strom-Assistent",
        "menu_options": {
          "tarif_hinzufuegen": "Add/change tariff",
          "tarif_entfernen": "Remove tariff",
          "preis_entitaet": "Dynamic price (optional)",
          "lastprofil": "Load profile & anomaly",
          "geraete": "Device detection",
          "luecken": "Statistics gaps"
        }
      },
      "tarif_hinzufuegen": {
        "title": "Tariff",
        "data": {
          "gueltig_ab": "Valid from",
          "grundpreis": "Base price (EUR/month)",
          "arbeitspreis": "Import price (EUR/kWh)",
          "einspeiseverguetung": "Feed-in tariff (EUR/kWh)"
        }
      },
      "tarif_entfernen": { "title": "Remove tariff", "data": { "tarife": "Tariffs to remove" } },
